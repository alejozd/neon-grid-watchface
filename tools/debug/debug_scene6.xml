<?xml version="1.0" encoding="UTF-8"?>
<WatchFace width="480" height="480">
  <Metadata key="CLOCK_TYPE" value="ANALOG"/>
  <Scene backgroundColor="#FF101820">
    <PartImage x="0" y="0" width="480" height="480">
      <Image resource="bg_ambient"/>
    </PartImage>
    <AnalogClock x="0" y="0" width="480" height="480">
      <HourHand resource="hand_hour_ambient" x="231.0" y="124.0" width="18" height="137"
          pivotX="0.5" pivotY="0.846715"/>
      <MinuteHand resource="hand_minute_ambient" x="231.75" y="74.0" width="16" height="189"
          pivotX="0.5" pivotY="0.878307"/>
    </AnalogClock>

    <!-- P1 exact generator output: float coords + monospace + ls + bold -->
    <PartText x="0.0" y="20.0" width="480.0" height="29.0">
      <Text align="CENTER">
        <Font family="monospace" size="20" color="#FFFFFFFF" letterSpacing="0.13" weight="BOLD">
          <Template><![CDATA[P1=%s]]>
          <Parameter expression="[SECOND_Z]"/>
      </Template>
        </Font>
      </Text>
    </PartText>

    <!-- P2 integer coords, same font attrs -->
    <PartText x="0" y="90" width="480" height="29">
      <Text align="CENTER">
        <Font family="monospace" size="20" color="#FF22E7FF" letterSpacing="0.13" weight="BOLD">
          <Template><![CDATA[P2=%s]]>
            <Parameter expression="[SECOND_Z]"/>
          </Template>
        </Font>
      </Text>
    </PartText>

    <!-- P3 system font -->
    <PartText x="0" y="160" width="480" height="29">
      <Text align="CENTER">
        <Font family="SYNC_TO_DEVICE" size="20" color="#FFFF2A6D" letterSpacing="0.13" weight="BOLD">
          <Template><![CDATA[P3=%s]]>
            <Parameter expression="[SECOND_Z]"/>
          </Template>
        </Font>
      </Text>
    </PartText>

    <!-- P4 no weight -->
    <PartText x="0" y="230" width="480" height="29">
      <Text align="CENTER">
        <Font family="monospace" size="20" color="#FFFFB020" letterSpacing="0.13">
          <Template><![CDATA[P4=%s]]>
            <Parameter expression="[SECOND_Z]"/>
          </Template>
        </Font>
      </Text>
    </PartText>

    <!-- P5 no letterSpacing -->
    <PartText x="0" y="300" width="480" height="29">
      <Text align="CENTER">
        <Font family="monospace" size="20" color="#FFA24BFF" weight="BOLD">
          <Template><![CDATA[P5=%s]]>
            <Parameter expression="[SECOND_Z]"/>
          </Template>
        </Font>
      </Text>
    </PartText>

    <!-- P6 height equals size*1.45 but integer-ish, size 20 -->
    <PartText x="0" y="370" width="480" height="29">
      <Text align="CENTER">
        <Font family="monospace" size="20" color="#FF35D07F" letterSpacing="0.0" weight="BOLD">
          <Template><![CDATA[P6=%s]]>
            <Parameter expression="[SECOND_Z]"/>
          </Template>
        </Font>
      </Text>
    </PartText>

  </Scene>
</WatchFace>
