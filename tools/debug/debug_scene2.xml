<?xml version="1.0" encoding="UTF-8"?>
<!-- DEBUG 2: everything inside ONE Group, small boxes, bg + hands present -->
<WatchFace width="480" height="480">
  <Metadata key="CLOCK_TYPE" value="ANALOG"/>
  <Scene backgroundColor="#FF101820">

    <PartImage x="0" y="0" width="480" height="480">
      <Image resource="bg_ambient"/>
    </PartImage>

    <AnalogClock x="0" y="0" width="480" height="480">
      <HourHand resource="hand_hour_ambient" x="231.0" y="124.0" width="18" height="137"
          pivotX="0.5" pivotY="0.846715"/>
      <MinuteHand resource="hand_minute_ambient" x="231.75" y="74.0" width="16" height="189"
          pivotX="0.5" pivotY="0.878307"/>
    </AnalogClock>

    <Group x="0" y="0" width="480" height="480" name="t">
      <!-- 1: plain text, no Template -->
      <PartText x="0" y="30" width="480" height="50">
        <Text align="CENTER">
          <Font family="SYNC_TO_DEVICE" size="30" color="#FFFFFFFF">A1-PLAIN</Font>
        </Text>
      </PartText>

      <!-- 2: Template with literal text only -->
      <PartText x="0" y="90" width="480" height="50">
        <Text align="CENTER">
          <Font family="SYNC_TO_DEVICE" size="30" color="#FF22E7FF">
            <Template><![CDATA[B2-TEMPLATE]]></Template>
          </Font>
        </Text>
      </PartText>

      <!-- 3: Parameter with integer data source -->
      <PartText x="0" y="150" width="480" height="50">
        <Text align="CENTER">
          <Font family="SYNC_TO_DEVICE" size="30" color="#FFFF2A6D">
            <Template><![CDATA[C3=%s]]>
              <Parameter expression="[SECOND]"/>
            </Template>
          </Font>
        </Text>
      </PartText>

      <!-- 4: Parameter with STRING data source -->
      <PartText x="0" y="210" width="480" height="50">
        <Text align="CENTER">
          <Font family="SYNC_TO_DEVICE" size="30" color="#FFFFB020">
            <Template><![CDATA[D4=%s]]>
              <Parameter expression="[SECOND_Z]"/>
            </Template>
          </Font>
        </Text>
      </PartText>

      <!-- 5: Parameter with battery integer -->
      <PartText x="0" y="270" width="480" height="50">
        <Text align="CENTER">
          <Font family="SYNC_TO_DEVICE" size="30" color="#FFA24BFF">
            <Template><![CDATA[E5=%s]]>
              <Parameter expression="[BATTERY_PERCENT]"/>
            </Template>
          </Font>
        </Text>
      </PartText>

      <!-- 6: two parameters, integers -->
      <PartText x="0" y="330" width="480" height="50">
        <Text align="CENTER">
          <Font family="SYNC_TO_DEVICE" size="30" color="#FF35D07F">
            <Template><![CDATA[F6=%s:%s]]>
              <Parameter expression="[HOUR_0_23]"/>
              <Parameter expression="[MINUTE]"/>
            </Template>
          </Font>
        </Text>
      </PartText>

      <!-- 7: image still renders after all the text? -->
      <PartImage x="200" y="400" width="80" height="24">
        <Image resource="lbl_msg"/>
      </PartImage>
    </Group>

  </Scene>
</WatchFace>
