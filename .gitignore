# --- Artefactos de compilación (se regeneran con build.ps1) ---
build/*.idsig
build/resources.zip
build/*-unsigned.apk
build/*-aligned.apk
build/keep-watchface.xml
build/watchface-v*.xml
build/face-*.png
build/hr-screen.png
build/resolver.png

# --- Salidas del modo de prueba de WFS (tools/test_wfs.ps1) ---
# Se regeneran con `tools\test_wfs.ps1`; las capturas buenas se copian a
# build/wfs-render.png y build/wfs-aod.png (esas sí se versionan).
build/wfs-test/
.wfs-test-profile/
.tmp-wfs-profile/

# --- Intermedios de Python ---
__pycache__/
*.pyc
*.pyo

# --- Sistema ---
Thumbs.db
desktop.ini
.DS_Store

# NOTA: build/keystore/cyber.jks SÍ se versiona a propósito.
# Es una clave de desarrollo autofirmada, con contraseña conocida y solo para
# instalar por adb en el reloj propio. Para publicar en Play, usa otra clave.
